    "app.ItemDef.ID_Fixed": {
        "format": "{data:name}:{enum:}",
        "queries": {
            "row": "rsz(assets/mhwilds/itemData.user.3)._Values[ _ItemId == $self ]"
        },
        "data": {
            "name": "msg(assets/mhwilds/Item.msg.23)[ @row._RawName ]",
            "explain": "msg(assets/mhwilds/Item.msg.23)[ @row._RawExplain ]"
        }
